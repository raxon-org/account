{
  "System": {
    "Doctrine": {
      "Schema": [
        {
          "table": "user",
          "entity": "User",
          "column": [
            {
              "name": "id",
              "type": "bigint",
              "options": {
                "id": true,
                "unsigned": true,
                "autoincrement": true
              }
            },
            {
              "name": "uuid",
              "type": "string",
              "options": {
                "length": 36
              }
            },
            {
              "name": "email",
              "type": "string",
              "options": {
              }
            },
            {
              "name": "key",
              "type": "string",
              "options": {
                "default": null,
                "nullable": true
              }
            },
            {
              "name": "password",
              "type": "string",
              "options": {
              }
            },
            {
              "name": "refresh_token",
              "type": "string",
              "options": {
                "default": null,
                "nullable": true
              }
            },
            {
              "name": "profile",
              "type": "one-to-one",
              "options": {
                "target": {
                  "entity": "Profile"
                },
                "mapped": {
                  "by": "user"
                },
                "nullable": true
              }
            },
            {
              "name": "role",
              "type": "json",
              "options": {
                  "node": {
                  "class": "Account.Role"
                }
              },
              "#comment": [
                "We get the role from raxon/node, this is an array of uuids"
              ]
            },
            {
              "name": "is_active",
              "type": "boolean",
              "options": {
                "default": false
              }
            },
            {
              "name": "is_logged_in",
              "type": "datetime",
              "options": {
                "default": null,
                "nullable": true
              }
            },
            {
              "name": "is_created",
              "type": "datetime",
              "options": {
                "default": "CURRENT_TIMESTAMP"
              }
            },
            {
              "name": "is_updated",
              "type": "datetime",
              "options": {
                "default": "CURRENT_TIMESTAMP"
              }
            },
            {
              "name": "is_deleted",
              "type": "datetime",
              "options": {
                "default": null,
                "nullable": true
              }
            }
          ],
          "primary_key": [
            "id"
          ],
          "index": [
            "is_active",
            "is_logged_in",
            "is_created",
            "is_updated",
            "is_deleted"
          ],
          "unique": [
            "uuid",
            "email",
            "key",
            "password",
            "refresh_token"
          ]
        }
      ]
    }
  }
}