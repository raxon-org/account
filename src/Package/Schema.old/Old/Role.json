{
  "System": {
    "Doctrine": {
      "Schema": [
        {
          "table": "role",
          "entity": "Role",
          "column": [
            {
              "name": "id",
              "type": "bigint",
              "options": {
                "id": true,
                "unsigned": true,
                "autoincrement": true
              }
            },
            {
              "name": "uuid",
              "type": "string",
              "options": {
                "length": 36
              }
            },
            {
              "name": "name",
              "type": "string",
              "options": {
              }
            },
            {
              "name": "rank",
              "type": "bigint",
              "options": {
                "unsigned": true
              }
            },
            {
              "name": "user",
              "type": "many-to-many",
              "options": {
                "target": "User",
                "map": "roles",
                "cascade": [
                  "persist"
                ]
              }
            },
            {
              "name": "permission",
              "type": "many-to-many",
              "options": {
                "target": "Permission",
                "inverse": "roles",
                "cascade": [
                  "persist"
                ],
                "join": {
                  "table": "role_permission",
                  "column": [
                    {
                      "name": "role_id",
                      "type": "bigint",
                      "reference": "id"
                    },
                    {
                      "name": "permission_id",
                      "type": "bigint",
                      "reference": "id"
                    }
                  ]
                }
              }
            }
          ],
          "primary_key": [
            "id"
          ],
          "index": [
          ],
          "unique": [
            "uuid",
            "name",
            "rank"
          ]
        }
      ]
    }
  }
}
