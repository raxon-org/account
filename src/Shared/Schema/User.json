{
  "System": {
    "Doctrine": {
      "Schema": [
        {
          "table": "user",
          "entity": "User",
          "version": "2026-01-21",
          "column": [
            {
              "name": "id",
              "type": "integer",
              "options": {
                "id": true,
                "unsigned": true,
                "autoincrement": true
              }
            },
            {
              "name": "uuid",
              "type": "string",
              "options": {
                "length": 36
              }
            },
            {
              "name": "email",
              "type": "string",
              "options": {
              }
            },
            {
              "name": "key",
              "type": "string",
              "options": {
                "default": null,
                "nullable": true
              }
            },
            {
              "name": "password",
              "type": "string",
              "options": {
              }
            },
            {
              "name": "refreshToken",
              "type": "string",
              "options": {
                "default": null,
                "nullable": true
              }
            },
            {
              "name": "profile",
              "type": "one-to-one",
              "options": {
                "target": {
                  "entity": "Profile"
                },
                "mapped": {
                  "by": "user"
                },
                "nullable": true
              }
            },
            {
              "name": "role",
              "type": "json",
              "options": {
                  "target": {
                    "node": {
                      "class": "Account.Role",
                      "sort": {
                        "rank" :"ASC"
                      },
                      "relation": true,
                      "multiple": true
                    }
                  }
              },
              "#comment": [
                "We get the role from raxon/node, this is an array of uuids"
              ]
            },
            {
              "name": "isActive",
              "type": "boolean",
              "options": {
                "default": false
              }
            },
            {
              "name": "isLoggedIn",
              "type": "datetime",
              "options": {
                "default": null,
                "nullable": true
              }
            },
            {
              "name": "isCreated",
              "type": "datetime",
              "options": {
                "default": "CURRENT_TIMESTAMP"
              }
            },
            {
              "name": "isUpdated",
              "type": "datetime",
              "options": {
                "default": "CURRENT_TIMESTAMP"
              }
            },
            {
              "name": "isDeleted",
              "type": "datetime",
              "options": {
                "default": null,
                "nullable": true
              }
            }
          ],
          "primary_key": [
            "id"
          ],
          "index": [
            "isActive",
            "isLoggedIn",
            "isCreated",
            "isUpdated",
            "isDeleted"
          ],
          "unique": [
            "uuid",
            "email",
            "key",
            "password",
            "refreshToken"
          ]
        }
      ]
    }
  }
}